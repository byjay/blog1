# Firebase AI Logic (Gemini API) is provisioned via App Check — no GEMINI_API_KEY is needed.
# Cloudflare & DDAKCHAL Server Automation tokens are configured inside the App's Server Console
# and persisted locally in DataStore (never committed to git or logged in plaintext).

# NAVER_CLIENT_ID / NAVER_CLIENT_SECRET: 네이버 개발자센터 무료 검색 API (일 25,000건) 인증 키
NAVER_CLIENT_ID=NAVER_CLIENT_ID_DEFAULT_VALUE
NAVER_CLIENT_SECRET=NAVER_CLIENT_SECRET_DEFAULT_VALUE
